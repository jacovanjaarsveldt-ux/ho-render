"chapters": [
{
"a": 7.38,
"b": 10.98,
"n": "Chapter 1",
"t": "The Warning"
}
],
"caps": [
{
"a": 0.03,
"b": 4.77,
"t": "Three astronauts heading for the Moon were\nsaved by an air filter made of duct tape"
},
{
"a": 4.77,
"b": 7.34,
"t": "and the covers of their own manuals."
},
{
"a": 7.41,
"b": 12.03,
"t": "Apollo 13 was two days out\nwhen an oxygen tank blew up."
},
{
"a": 12.03,
"b": 14.07,
"t": "The crew moved into the lunar lander,"
},
{
"a": 14.07,
"b": 18.39,
"t": "built for two men, and the air\nfilled with carbon dioxide."
},
{
"a": 18.39,
"b": 20.37,
"t": "The spare filters were square,"
},
{
"a": 20.37,
"b": 22.92,
"t": "and the lander only took round ones."
},
{
"a": 22.99,
"b": 26.91,
"t": "So engineers in Houston designed\na fix from things on board,"
},
{
"a": 26.91,
"b": 29.43,
"t": "and read it to the crew over the radio."
},
{
"a": 29.43,
"b": 32.51,
"t": "It was plastic bags, cardboard and tape,"
},
{
"a": 32.51,
"b": 35.26,
"t": "and it looked terrible, but it worked."
},
{
"a": 35.27,
"b": 37.89,
"t": "Ken Mattingly was meant\nto fly that mission,"
},
{
"a": 37.89,
"b": 41.77,
"t": "but he was pulled days before\nlaunch over a measles scare."
},
{
"a": 41.77,
"b": 46.12,
"t": "He never got sick, and two\nyears later he flew to the Moon."
},
{
"a": 47.03,
"b": 51.77,
"t": "Three astronauts heading for the Moon were\nsaved by an air filter made of duct tape"
},
{
"a": 51.77,
"b": 54.34,
"t": "and the covers of their own manuals."
},
{
